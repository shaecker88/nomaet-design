{
  "$description": "NOMAETstudios Design-Tokens. Einzige Quelle für Farben, Schrift, Abstände. Änderungen hier, dann tokens.css nachziehen.",
  "color": {
    "paper":  { "$value": "#EFEDE6", "$description": "Grundfläche. Ca. 60 % jeder Fläche." },
    "ink":    { "$value": "#16150F", "$description": "Text, Logo, dunkle Flächen. Ca. 30 %." },
    "blue":   { "$value": "#2C3E8F", "$description": "Stempelblau. Einziger Akzent, max. 10 %: Links, Stempel, 'No matter what.'" },
    "grey":   { "$value": "#6B6A62", "$description": "Sekundärtext, nur auf Papier (4,6:1). Nie auf Sand." },
    "sand":   { "$value": "#D8C9A0", "$description": "Nur Flächen/Etiketten. Nie als Textfarbe auf Papier (1,4:1)." },
    "white":  { "$value": "#FFFFFF", "$description": "Nur Produktfoto-Hintergründe, nie UI-Fläche." }
  },
  "font": {
    "logo":    { "$value": "Boldonse", "$description": "Ausschließlich Logo 'nomaet.' und Zeichen 'n.'. Nie für Überschriften." },
    "display": { "$value": "Inter Tight", "$description": "Überschriften, Navigation, Buttons, Etiketten." },
    "text":    { "$value": "Inter", "$description": "Fließtext, Produktbeschreibungen, Formulare." }
  },
  "fontWeight": {
    "text": 400, "textStrong": 500, "label": 600, "heading": 700, "statement": 800
  },
  "fontSize": {
    "label":     { "$value": "0.75rem",  "$description": "Etiketten, Versalien, Sperrung 0.12em" },
    "small":     { "$value": "0.875rem" },
    "body":      { "$value": "1rem" },
    "lead":      { "$value": "1.25rem" },
    "h3":        { "$value": "clamp(1.25rem, 1rem + 1vw, 1.75rem)" },
    "h2":        { "$value": "clamp(1.75rem, 1.2rem + 2.4vw, 3rem)" },
    "h1":        { "$value": "clamp(2.5rem, 1.5rem + 4.5vw, 5.5rem)" },
    "statement": { "$value": "clamp(3rem, 1.5rem + 7vw, 9rem)", "$description": "Ein Satz pro Seite, z. B. 'Made to stay.'" }
  },
  "letterSpacing": { "label": "0.12em", "heading": "-0.02em", "statement": "-0.035em" },
  "lineHeight": { "tight": 0.95, "heading": 1.1, "body": 1.6 },
  "space": {
    "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "6": "1.5rem",
    "8": "2rem", "12": "3rem", "16": "4rem", "24": "6rem", "32": "8rem"
  },
  "radius": { "none": "0", "photo": "0", "pill": "999px", "$description": "Archiv ist eckig: Buttons, Karten, Fotos ohne Rundung. Pill nur für Filter-Chips." },
  "border": { "hairline": "1px solid #16150F", "soft": "1px solid rgba(22,21,15,0.15)" },
  "motion": {
    "duration": { "fast": "150ms", "base": "300ms", "reveal": "700ms" },
    "easing":   { "out": "cubic-bezier(0.2, 0.7, 0.2, 1)" },
    "$description": "Bewegung = ruhiges Einblenden beim Scrollen. Kein Wackeln, kein Hüpfen. prefers-reduced-motion immer respektieren."
  },
  "layout": { "contentMax": "1320px", "proseMax": "46rem", "gutterMobile": "1rem", "gutterDesktop": "2.5rem" }
}
