{%- comment -%}
  nomaet. Shop-Seite. Stand 22.10.2026 nach Markenkern (docs/markenkern.md): der Shop ist ruhig.
  Gerades Bild (bis zum Shooting Typo-Karte auf Weiß), N°-Label, Name, Preis, Button. Keine Polaroids, kein Klebeband, kein Stempel,
  keine Handschrift, kein Post-it. Keine Filter, keine Sortierung.
  "Echte Produktfotos zeigen" im Theme-Editor aktivieren, sobald es echte Fotos gibt.
  Reihenfolge: Kette (N° 0001) zuerst, dann Ring (N° 0002), dann alle weiteren Produkte.
{%- endcomment -%}
{%- liquid
  assign de = false
  if request.locale.iso_code == 'de'
    assign de = true
  endif
-%}

<div class="nc">
  <header class="nc__head">
    <p class="nc__label">{% if de %}Der Shop{% else %}The shop{% endif %}</p>
    <h1 class="nc__title">Chapter 01.</h1>
    <p class="nc__intro">{% if de %}Zwei Stücke für Verbindungen, die kein Zufall sind. Gemacht, um jeden Tag getragen zu werden.{% else %}Two pieces for the ones that were meant to be. Made to be worn every day.{% endif %}</p>
    <p class="nc__meta">
      <span>{% if de %}Erste Auflage{% else %}First edition{% endif %}</span>
      <span>{% if de %}Design aus Stuttgart{% else %}Designed in Stuttgart{% endif %}</span>
      <span>{% if de %}Silber · Vergoldet · Gold 585{% else %}Silver · Gold-plated · Gold 585{% endif %}</span>
    </p>
  </header>

  {%- paginate collection.products by 24 -%}
  <ul class="nc__grid" role="list">
    {%- assign n = 0 -%}
    {%- for pass in (1..2) -%}
      {%- for product in collection.products -%}
        {%- if pass == 1 and product.handle != 'die-goldkette' -%}{%- continue -%}{%- endif -%}
        {%- if pass == 2 and product.handle == 'die-goldkette' -%}{%- continue -%}{%- endif -%}
        {%- assign n = n | plus: 1 -%}
        {%- if product.handle == 'die-goldkette' -%}{%- assign no = '0001' -%}
        {%- elsif product.handle == 'the-ring' -%}{%- assign no = '0002' -%}
        {%- else -%}{%- assign no = n | prepend: '000' | slice: -4, 4 -%}{%- endif -%}
        {%- assign imgs = product.images | slice: 0, 5 -%}
        <li class="nc__item">
          <a class="nc__card" href="{{ product.url }}">
            <span class="nc__media">
              {%- if section.settings.show_product_photos and imgs.size > 0 -%}
                {%- for img in imgs -%}
                  {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 92vw', class: 'nc__img', data-active: forloop.first, alt: img.alt | default: product.title }}
                {%- endfor -%}
                {%- if imgs.size > 1 -%}
                  <button type="button" class="nc__arrow nc__arrow--prev" data-dir="-1" aria-label="{% if de %}Vorheriges Bild{% else %}Previous image{% endif %}">&lsaquo;</button>
                  <button type="button" class="nc__arrow nc__arrow--next" data-dir="1" aria-label="{% if de %}Nächstes Bild{% else %}Next image{% endif %}">&rsaquo;</button>
                {%- endif -%}
              {%- else -%}
                <span class="nc__typo" aria-hidden="true">{% if product.handle == 'die-goldkette' %}{% if de %}Schloss{% else %}Lock{% endif %}{% elsif product.handle == 'the-ring' %}Pinky<br>Promise{% else %}{{ product.title }}{% endif %}</span>
              {%- endif -%}
              {%- unless product.available -%}<span class="nc__badge">{% if de %}Ausverkauft{% else %}Sold out{% endif %}</span>{%- endunless -%}
            </span>
            <span class="nc__caption">
              <span class="nc__no">N° {{ no }} · CHAPTER 01</span>
              <span class="nc__info">
                <span class="nc__name">{{ product.title }}</span>
                <span class="nc__price">{% if product.price_varies %}{% if de %}ab{% else %}from{% endif %} {% endif %}{{ product.price_min | money }}</span>
              </span>
              <span class="nc__tax">{% if de %}Inkl. MwSt., zzgl. Versand{% else %}Taxes included, plus shipping{% endif %}</span>
              <span class="nc__line">
                {%- if product.handle == 'die-goldkette' -%}{% if de %}Der kleine Schloss-Anhänger. 36/38 bis 60 cm.{% else %}The small lock pendant. 36/38 to 60 cm.{% endif %}
                {%- elsif product.handle == 'the-ring' -%}{% if de %}Schmaler Ring, innen ein kleiner Schlüssel. Größen 42 bis 60.{% else %}A slim band with a tiny key inside. Sizes 42 to 60.{% endif %}
                {%- endif -%}
              </span>
              <span class="nc__cta">{% if de %}Ansehen{% else %}View piece{% endif %} <i aria-hidden="true">→</i></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    {%- endfor -%}

    {%- if section.settings.show_next -%}
      <li class="nc__item nc__item--next">
        <a class="nc__card nc__card--next" href="/#newsletter">
          <span class="nc__media nc__media--next">
            <span class="nc__next-num" aria-hidden="true">02</span>
          </span>
          <span class="nc__caption">
            <span class="nc__no">CHAPTER 02</span>
            <span class="nc__info"><span class="nc__name">{% if de %}In Arbeit.{% else %}In the works.{% endif %}</span></span>
            <span class="nc__line">{% if de %}Trag dich ein, dann erfährst du es zuerst.{% else %}Join the list to hear first.{% endif %}</span>
            <span class="nc__cta">{% if de %}Auf die Liste{% else %}Join the list{% endif %} <i aria-hidden="true">→</i></span>
          </span>
        </a>
      </li>
    {%- endif -%}
  </ul>
  {%- if paginate.pages > 1 -%}<nav class="nc__pages">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}

  <div class="nc__after">
    <a class="nc__after-link" href="/pages/size-guide">
      <span class="nc__after-k">{% if de %}Unsicher bei der Größe?{% else %}Not sure about your size?{% endif %}</span>
      <span class="nc__after-v">{% if de %}Zur Größentabelle{% else %}Size guide{% endif %} <i aria-hidden="true">→</i></span>
    </a>
    <a class="nc__after-link" href="/pages/about">
      <span class="nc__after-k">{% if de %}Warum ein Schloss?{% else %}Why a lock?{% endif %}</span>
      <span class="nc__after-v">{% if de %}Unsere Geschichte{% else %}Our story{% endif %} <i aria-hidden="true">→</i></span>
    </a>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.nc');
    if (!root) return;
    root.querySelectorAll('.nc__media').forEach(function (media) {
      var imgs = media.querySelectorAll('.nc__img');
      if (imgs.length < 2) return;
      var active = 0;
      media.querySelectorAll('.nc__arrow').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault(); e.stopPropagation();
          imgs[active].removeAttribute('data-active');
          active = (active + parseInt(btn.dataset.dir, 10) + imgs.length) % imgs.length;
          imgs[active].setAttribute('data-active', 'true');
        });
      });
    });
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('nc--js');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    root.querySelectorAll('.nc__item').forEach(function (el, i) { el.style.setProperty('--d', (i % 3) * 0.1 + 's'); io.observe(el); });
  })();
</script>

{% stylesheet %}
  .nc { --nc-paper: var(--nmw-paper, #EFEDE6); --nc-ink: var(--nmw-ink, #16150F); --nc-blue: var(--nmw-blue, #2C3E8F); --nc-grey: var(--nmw-mute, #6B6A62); --nc-white: #FFFFFF;
        --nc-display: var(--nmw-sans-tight, 'Inter Tight', 'Inter', sans-serif); --nc-text: var(--nmw-sans, 'Inter', sans-serif);
        padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(3.5rem, 8vw, 6.5rem); background: var(--nc-paper); color: var(--nc-ink); font: 400 1rem/1.6 var(--nc-text); }
  .nc *, .nc *::before, .nc *::after { box-sizing: border-box; }
  .nc :where(a) { color: inherit; text-decoration: none; }
  .nc :focus-visible { outline: 2px solid var(--nc-blue); outline-offset: 4px; }

  /* Kopf */
  .nc__head { width: min(100% - 2.5rem, 1200px); margin: 0 auto clamp(2.5rem, 6vw, 4rem); }
  .nc__label { margin: 0 0 1rem; font: 600 .75rem/1 var(--nc-display); letter-spacing: .14em; text-transform: uppercase; color: var(--nc-grey); }
  .nc__title { margin: 0; font: 800 clamp(3rem, 1.4rem + 8vw, 7.5rem)/.9 var(--nc-display); letter-spacing: -.045em; }
  .nc__intro { max-width: 32rem; margin: 1.25rem 0 0; color: var(--nc-grey); font-size: clamp(1rem, .95rem + .3vw, 1.15rem); }
  .nc__meta { display: flex; flex-wrap: wrap; gap: .4rem 0; margin: 1.25rem 0 0; font: 600 .7rem/1.4 var(--nc-display); letter-spacing: .14em; text-transform: uppercase; }
  .nc__meta span + span::before { content: "/"; margin-inline: .8rem; color: var(--nc-grey); }

  /* Raster */
  .nc__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(2rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2rem); width: min(100% - 2.5rem, 1200px); margin: 0 auto; padding: 0; list-style: none; }
  .nc__card { display: block; }
  .nc__media { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--nc-white); }
  .nc__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .35s ease, transform .9s cubic-bezier(.2,.7,.2,1); }
  .nc__img[data-active="true"] { opacity: 1; }
  .nc__card:hover .nc__img[data-active="true"] { transform: scale(1.03); }
  .nc__typo { position: absolute; inset: 0; display: grid; place-items: center; padding: 1.5rem; font: 800 clamp(2.2rem, 1rem + 3.6vw, 4.2rem)/.9 var(--nc-display); letter-spacing: -.045em; text-align: center; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .nc__card:hover .nc__typo { transform: scale(1.03); }
  .nc__arrow { position: absolute; top: 50%; z-index: 2; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; margin-top: -1.125rem; padding: 0; border: 0; border-radius: 50%; background: rgb(255 255 255 / .9); color: var(--nc-ink); font-size: 1.3rem; line-height: 1; cursor: pointer; }
  .nc__arrow--prev { left: .6rem; }
  .nc__arrow--next { right: .6rem; }
  .nc__badge { position: absolute; top: .75rem; left: .75rem; padding: .35rem .6rem; background: var(--nc-paper); font: 600 .66rem/1 var(--nc-display); letter-spacing: .14em; text-transform: uppercase; }

  .nc__caption { display: block; padding-top: 1rem; }
  .nc__no { display: block; font: 600 .7rem/1.3 var(--nc-display); letter-spacing: .12em; color: var(--nc-grey); }
  .nc__info { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: .4rem; }
  .nc__name { font: 700 clamp(1.1rem, 1rem + .5vw, 1.35rem)/1.2 var(--nc-display); letter-spacing: -.02em; }
  .nc__card:hover .nc__name { text-decoration: underline; text-underline-offset: .2em; text-decoration-thickness: 1px; }
  .nc__price { font: 600 1rem/1.2 var(--nc-display); white-space: nowrap; }
  .nc__tax { display: block; margin-top: .2rem; font-size: .75rem; color: var(--nc-grey); }
  .nc__line { display: block; margin-top: .5rem; color: var(--nc-grey); font-size: .9375rem; line-height: 1.5; }
  .nc__line:empty { display: none; }
  .nc__cta { display: inline-flex; align-items: center; gap: .5rem; margin-top: .9rem; font: 700 .72rem/1 var(--nc-display); letter-spacing: .14em; text-transform: uppercase; }
  .nc__cta i { font-style: normal; transition: transform .3s ease; }
  .nc__card:hover .nc__cta i { transform: translateX(.3rem); }

  /* Chapter 02 */
  .nc__media--next { display: grid; place-items: center; background: transparent; border: 1px solid rgb(22 21 15 / .2); }
  .nc__next-num { font: 800 clamp(4rem, 2rem + 6vw, 7rem)/.85 var(--nc-display); letter-spacing: -.05em; color: rgb(22 21 15 / .18); }

  /* Danach */
  .nc__after { display: grid; grid-template-columns: 1fr 1fr; width: min(100% - 2.5rem, 1200px); margin: clamp(3.5rem, 8vw, 6rem) auto 0; border-top: 1px solid var(--nc-ink); }
  .nc__after-link { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid rgb(22 21 15 / .15); }
  .nc__after-link + .nc__after-link { padding-left: clamp(1.5rem, 4vw, 3rem); border-left: 1px solid rgb(22 21 15 / .15); }
  .nc__after-link:first-child { padding-right: clamp(1.5rem, 4vw, 3rem); }
  .nc__after-k { font: 700 clamp(1.1rem, 1rem + .6vw, 1.5rem)/1.2 var(--nc-display); letter-spacing: -.02em; }
  .nc__after-v { font: 700 .72rem/1 var(--nc-display); letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
  .nc__after-v i { font-style: normal; display: inline-block; transition: transform .3s ease; }
  .nc__after-link:hover .nc__after-v i { transform: translateX(.3rem); }
  .nc__pages { width: min(100% - 2.5rem, 1200px); margin: 3rem auto 0; text-align: center; }

  /* Ruhiges Einblenden */
  .nc--js .nc__item { opacity: 0; translate: 0 18px; transition: opacity .7s ease var(--d, 0s), translate .7s cubic-bezier(.2,.7,.2,1) var(--d, 0s); }
  .nc--js .nc__item.is-in { opacity: 1; translate: 0 0; }

  @media screen and (max-width: 989px) {
    .nc__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 749px) {
    .nc__grid { grid-template-columns: 1fr; gap: 2.5rem; width: min(100% - 2rem, 30rem); }
    .nc__head { width: min(100% - 2rem, 30rem); }
    .nc__item--next .nc__media--next { aspect-ratio: 16 / 7; }
    .nc__meta { font-size: .64rem; }
    .nc__meta span + span::before { margin-inline: .5rem; }
    .nc__after { grid-template-columns: 1fr; width: min(100% - 2rem, 30rem); }
    .nc__after-link + .nc__after-link { padding-left: 0; border-left: 0; }
    .nc__after-link:first-child { padding-right: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .nc__img, .nc__typo, .nc__cta i, .nc__after-v i { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "nomaet. Shop-Seite",
  "settings": [
    { "type": "checkbox", "id": "show_product_photos", "label": "Echte Produktfotos zeigen (nach dem Shooting aktivieren)", "default": false },
    { "type": "checkbox", "id": "show_next", "label": "Chapter-02-Karte zeigen", "default": true }
  ],
  "presets": [{ "name": "nomaet. Shop-Seite" }]
}
{% endschema %}
